<?xml version="1.0" encoding="utf-8"?>
<!--
  agterm's own mark - the grid of sessions - with its last cell turned into a phone: the sessions on
  the Mac, one of them in your hand. Same blue ground as agterm's icon, so the two read as a pair.

  The plate is not a choice between having one and not having one - measured on API 37, the launcher
  always draws one. A transparent adaptive background renders as a BLACK disc, and a legacy PNG with
  alpha renders as a WHITE disc with the artwork shrunk inside it. So the plate is agterm's blue.

  The foreground is rendered from one SVG at all five densities, sized so the mark sits well inside
  the 66dp safe zone - nothing is clipped by a round, squircle or teardrop mask. The monochrome layer
  is the same mark, flat; it is why this stays an adaptive icon, so themed icons get the real shape.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
